<configuration>
    <!--
      Without a configuration file Logback defaults the root logger to DEBUG. In this image that
      means every Flyway classpath scan and every driver internal on stdout — noise that buries the
      one line an operator needs, and a disclosure risk the moment a library logs a statement or a
      connection string at that level.

      INFO by default, overridable per deployment. NODERA_LOG_FORMAT is documented in .env.example
      but not honoured yet: structured JSON output needs an encoder dependency and belongs with the
      observability work, not with the build chain.
    -->

    <!--
      Redaction at the boundary (SEC-01). %rmsg and %rex are %msg and the stack trace with anything
      credential-shaped removed, so a token that reached a log line through code nobody here wrote
      is contained rather than written. The pattern below uses them instead of %msg deliberately:
      swapping either back is what this guard is tested against.
    -->
    <conversionRule conversionWord="rmsg" class="ai.nodera.app.RedactingMessageConverter"/>
    <conversionRule conversionWord="rex" class="ai.nodera.app.RedactingThrowableConverter"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <!--
          stderr, not the default stdout. On the `mcp-stdio` entrypoint stdout is the MCP
          framing channel: the first library INFO line written there reaches an agent's client
          as a parse error rather than as a sentence. Docker and Kubernetes capture both
          streams, so nothing is lost by choosing the one that cannot corrupt a protocol.
        -->
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %rmsg%n%rex</pattern>
        </encoder>
    </appender>

    <root level="${NODERA_LOG_LEVEL:-INFO}">
        <appender-ref ref="console"/>
    </root>
</configuration>
