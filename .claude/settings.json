{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(make check*)",
      "Bash(make up)",
      "Bash(make migrate)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(./gradlew ktlintCheck*)",
      "Bash(./gradlew detekt*)",
      "Bash(./gradlew test*)",
      "Bash(yarn lint)",
      "Bash(yarn typecheck)",
      "Bash(yarn test:run)",
      "Bash(yarn test:coverage)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
