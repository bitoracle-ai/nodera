# Nodera — local development environment.
# Copy to `.env` (git-ignored) and fill in. Never commit a filled-in copy.
#
# Every variable without a default is REQUIRED: the backend refuses to start when one
# is missing rather than falling back to a guessable value. That is a security control,
# not an inconvenience — see skills/secure-coding.md § Fail closed.
#
# ---- Secrets from files -----------------------------------------------------
# Every secret below also has a `_FILE` form — set NODERA_DB_PASSWORD_FILE to a path and
# Nodera reads the value from it, minus any trailing newline. Docker Secrets, Kubernetes
# Secrets and Vault all deliver secrets as mounted files, and a value passed as an
# environment variable is readable in `docker inspect` and in the process table.
#
# Setting BOTH forms of the same variable is refused at start-up rather than resolved by
# precedence. A precedence rule settles the ambiguity silently, and the operator finds out
# which value won during an incident.
#
# ---- Which command needs what -----------------------------------------------
# Configuration is loaded per command, so a process never has to be given a credential it
# does not use:
#   migrate     the database block, including NODERA_APP_PASSWORD
#   serve       the database block and the HTTP block; NOT NODERA_APP_PASSWORD
#   mcp-stdio   nothing

# ---- Database ---------------------------------------------------------------
NODERA_DB_URL=jdbc:postgresql://localhost:5432/nodera
NODERA_DB_USER=nodera
NODERA_DB_PASSWORD=<your-local-password>

# Substituted into V4's `create role nodera_app`. Needed by `migrate` only — the serving
# process connects AS nodera_app and must never hold the credentials that created it.
NODERA_APP_PASSWORD=<your-application-role-password>

# ---- HTTP server ------------------------------------------------------------
NODERA_HTTP_PORT=8080
# Where the built web assets live. In the image this is `static` beside the binary; in a
# development checkout, point it at the Vite output if you want the server to serve it.
NODERA_STATIC_ROOT=static
# Comma-separated exact origins. No wildcard is accepted in any environment.
# Not read today: the assets are served from the API's own origin, so a normal deployment
# is same-origin and installs no CORS plugin at all (ADR-0006).
NODERA_CORS_ORIGINS=http://localhost:5173

# ---- Identity ---------------------------------------------------------------
# Consumed from SEC-01 onward; no code reads these yet, and Nodera does not demand a
# secret it has no use for.
# 32+ random bytes, base64. Generate: openssl rand -base64 48
NODERA_JWT_SIGNING_KEY=<your-base64-signing-key>
NODERA_JWT_ISSUER=https://nodera.local
NODERA_ACCESS_TOKEN_TTL=PT15M
NODERA_REFRESH_TOKEN_TTL=P30D

# Optional OIDC provider for human sign-in. Leave empty to use local email+OTP only.
NODERA_OIDC_ISSUER=
NODERA_OIDC_CLIENT_ID=
NODERA_OIDC_CLIENT_SECRET=

# ---- Agent actors -----------------------------------------------------------
# Personal access tokens for agents are hashed with Argon2id before storage.
# These are cost parameters, not secrets.
NODERA_TOKEN_HASH_MEMORY_KIB=65536
NODERA_TOKEN_HASH_ITERATIONS=3
NODERA_TOKEN_HASH_PARALLELISM=1

# ---- MCP server -------------------------------------------------------------
# `stdio` for a locally spawned server, `http` for the streamable HTTP transport.
NODERA_MCP_TRANSPORT=stdio
NODERA_MCP_HTTP_PORT=8081
# Hard ceiling on rows any single MCP tool call may return, regardless of arguments.
NODERA_MCP_MAX_PAGE_SIZE=100

# ---- Observability ----------------------------------------------------------
# Honoured: sets the root logger level. Without it the image would log at Logback's
# no-configuration default, DEBUG, which buries the useful line and risks a library
# logging a connection string.
NODERA_LOG_LEVEL=INFO
# `json` in every deployed environment; `pretty` is local-only.
# NOT honoured yet: structured JSON output needs an encoder dependency and belongs with the
# observability work rather than the build chain. The image currently logs the pretty pattern.
NODERA_LOG_FORMAT=pretty
NODERA_OTLP_ENDPOINT=

# ---- Frontend (Vite — only NODERA_PUBLIC_* reaches the browser bundle) ------
# Relative on purpose: the API serves the web assets from its own origin, so the browser
# never makes a cross-origin request and CORS is not part of a deployment.
NODERA_PUBLIC_API_BASE_URL=/api/v1
