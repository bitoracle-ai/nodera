# Nodera — local development environment.
# Copy to `.env` (git-ignored) and fill in. Never commit a filled-in copy.
#
# Every variable without a default is REQUIRED: the backend refuses to start when one
# is missing rather than falling back to a guessable value. That is a security control,
# not an inconvenience — see skills/secure-coding.md § Fail closed.

# ---- Database ---------------------------------------------------------------
NODERA_DB_URL=jdbc:postgresql://localhost:5432/nodera
NODERA_DB_USER=nodera
NODERA_DB_PASSWORD=<your-local-password>

# ---- HTTP server ------------------------------------------------------------
NODERA_HTTP_PORT=8080
# Comma-separated exact origins. No wildcard is accepted in any environment.
NODERA_CORS_ORIGINS=http://localhost:5173

# ---- Identity ---------------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
NODERA_JWT_SIGNING_KEY=<your-base64-signing-key>
NODERA_JWT_ISSUER=https://nodera.local
NODERA_ACCESS_TOKEN_TTL=PT15M
NODERA_REFRESH_TOKEN_TTL=P30D

# Optional OIDC provider for human sign-in. Leave empty to use local email+OTP only.
NODERA_OIDC_ISSUER=
NODERA_OIDC_CLIENT_ID=
NODERA_OIDC_CLIENT_SECRET=

# ---- Agent actors -----------------------------------------------------------
# Personal access tokens for agents are hashed with Argon2id before storage.
# These are cost parameters, not secrets.
NODERA_TOKEN_HASH_MEMORY_KIB=65536
NODERA_TOKEN_HASH_ITERATIONS=3
NODERA_TOKEN_HASH_PARALLELISM=1

# ---- MCP server -------------------------------------------------------------
# `stdio` for a locally spawned server, `http` for the streamable HTTP transport.
NODERA_MCP_TRANSPORT=stdio
NODERA_MCP_HTTP_PORT=8081
# Hard ceiling on rows any single MCP tool call may return, regardless of arguments.
NODERA_MCP_MAX_PAGE_SIZE=100

# ---- Observability ----------------------------------------------------------
NODERA_LOG_LEVEL=INFO
# `json` in every deployed environment; `pretty` is local-only.
NODERA_LOG_FORMAT=pretty
NODERA_OTLP_ENDPOINT=

# ---- Frontend (Vite — only NODERA_PUBLIC_* reaches the browser bundle) ------
NODERA_PUBLIC_API_BASE_URL=http://localhost:8080
